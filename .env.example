# ─── AI Provider Configuration ──────────────────────────────────
#
#  To connect StudyBrain to an AI backend, copy this file to .env
#  and fill in your credentials.
#
#    cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────

# Which AI provider to use.
# Supported: "openai" | "gemini" | "groq"
VITE_AI_PROVIDER=openai

# Your API key for the chosen provider.
#   OpenAI  → https://platform.openai.com/api-keys
#   Gemini  → https://aistudio.google.com/apikey
#   Groq    → https://console.groq.com/keys
#   ⚠️  Paste your key below (no quotes) — works immediately after restart.
VITE_AI_API_KEY=

# Optional: override the default model for the chosen provider.
#   OpenAI  → gpt-4o-mini (default), gpt-4o, gpt-4-turbo, etc.
#   Gemini  → gemini-2.0-flash (default), gemini-1.5-pro, etc.
#   Groq    → llama3-70b-8192 (default), mixtral-8x7b-32768, etc.
VITE_AI_MODEL=

# Optional: override the API base URL (useful for proxies or self-hosted).
VITE_AI_BASE_URL=
