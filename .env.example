# ─── AI Provider Configuration ──────────────────────────────────
#
#  To connect StudyBrain to an AI backend, copy this file to .env
#  and fill in your credentials.
#
#    cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────

# Which AI provider to use.
# Supported: "openai" | "gemini" | "groq"
VITE_AI_PROVIDER=openai

# Your API key for the chosen provider.
#   OpenAI  → https://platform.openai.com/api-keys
#   Gemini  → https://aistudio.google.com/apikey
#   Groq    → https://console.groq.com/keys
#   ⚠️  Paste your key below (no quotes) — works immediately after restart.
VITE_AI_API_KEY=

# Optional: override the default model for the chosen provider.
#   OpenAI  → gpt-4o-mini (default), gpt-4o, gpt-4-turbo, etc.
#   Gemini  → gemini-2.0-flash (default), gemini-1.5-pro, etc.
#   Groq    → llama3-70b-8192 (default), mixtral-8x7b-32768, etc.
VITE_AI_MODEL=

# Optional: override the API base URL (useful for proxies or self-hosted).
VITE_AI_BASE_URL=

# ─── Supabase Configuration ─────────────────────────────────────
#
#  Used by src/lib/supabase.js. Grab these from your Supabase
#  project: Project Settings → API. The anon key is safe to ship
#  client-side (Row Level Security enforces access).
#
# ─── Authentication Provider ────────────────────────────────────
# "local" (default) keeps the current localStorage-based auth.
# "supabase" switches signup/login/logout to Supabase Auth.
VITE_AUTH_PROVIDER=local

# ─── Notes Provider ─────────────────────────────────────────────
# "local" (default) keeps notes in localStorage (studybrain_notes_<email>).
# "supabase" stores notes in the Supabase "notes" table, scoped to the user.
VITE_NOTES_PROVIDER=local

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
